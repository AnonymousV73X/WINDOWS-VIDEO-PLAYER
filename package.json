{
  "name": "novaplay",
  "version": "2.0.0",
  "description": "NovaPlay v2 — Revolutionary video player with unified libVLC embedding, NovaTune-inspired UI, VLC-orange accent, dark/light mode. Supports every format from h264 to 10-bit x265.",
  "main": "app-shell/main.js",
  "author": "NovaPlay",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder --win --config electron.config.js",
    "build:portable": "electron-builder --win portable --config electron.config.js",
    "download-fonts": "node scripts/download-fonts.js",
    "make-icons": "node scripts/make_icons.js",
    "postinstall": "node scripts/check-deps.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "koffi": "^2.9.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.novaplay.player",
    "productName": "NovaPlay",
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "differentialPackage": true
    },
    "files": [
      "app-shell/**/*",
      "video-engine/**/*",
      "ui/**/*",
      "local-data/**/*",
      "assets/**/*",
      "scripts/**/*",
      "package.json"
    ]
  }
}

