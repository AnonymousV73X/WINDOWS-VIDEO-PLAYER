{
  "name": "novaplay",
  "version": "1.0.0",
  "description": "NovaPlay — A premium Windows video player with libVLC engine and NovaTune-dark aesthetics. 100% offline.",
  "main": "app-shell/main.js",
  "author": "NovaPlay",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder --win --config electron.config.js",
    "build:portable": "electron-builder --win portable --config electron.config.js",
    "download-fonts": "node scripts/download-fonts.js",
    "make-icons": "node scripts/make_icons.js",
    "postinstall": "node scripts/check-deps.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "chokidar": "^3.5.3",
    "fluent-ffmpeg": "^2.1.3",
    "koffi": "^2.9.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.novaplay.player",
    "productName": "NovaPlay",
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "differentialPackage": true
    },
    "files": [
      "app-shell/**/*",
      "video-engine/**/*",
      "ui/**/*",
      "local-data/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
